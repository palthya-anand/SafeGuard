# SafeGuard — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=replace_me_with_a_random_secret

# ── API ───────────────────────────────────────────────────────────────────────
# URL the Android app uses to reach the backend.
# For Android Emulator: use 10.0.2.2 which maps to localhost on the host.
API_BASE_URL=http://10.0.2.2:8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# ── Traffic Provider ──────────────────────────────────────────────────────────
# Set TRAFFIC_PROVIDER=mock to skip real API calls during development.
TRAFFIC_PROVIDER=mock
TRAFFIC_API_KEY=replace_me

# ── Weather Provider ──────────────────────────────────────────────────────────
# Supported: mock | openweathermap
WEATHER_PROVIDER=mock
WEATHER_API_KEY=replace_me
# OpenWeatherMap base URL (optional override)
OWM_BASE_URL=https://api.openweathermap.org/data/2.5

# ── Map Provider ─────────────────────────────────────────────────────────────
# Optional: Set your Mapbox access token (e.g. pk.eyJ1...) to enable Mapbox
# Navigation Night, Dark v11, and Streets styles. If empty, OpenStreetMap is used.
MAPBOX_API_KEY=

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
# Leave empty to use local-only notifications.
FCM_PROJECT_ID=replace_me
FIREBASE_CREDENTIALS_PATH=

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=data-science/models/accident_risk_model.joblib
PREPROCESSOR_PATH=data-science/models/preprocessor.joblib
HOTSPOT_PATH=data-science/data/processed/hotspots.csv

# ── Risk thresholds ───────────────────────────────────────────────────────────
HOTSPOT_RADIUS_M=500
OVERSPEED_TOLERANCE_KMH=5
ALERT_COOLDOWN_SECONDS=30
